# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Clerk Auth
CLERK_SECRET_KEY=sk_live_...
CLERK_PUBLISHABLE_KEY=pk_live_...

# Gemini AI (add more keys for quota rotation: GEMINI_API_KEY_2, _3, ...)
GEMINI_API_KEY=AIza...

# Modal GPU Worker URLs (순서대로 시도, 소진 시 다음 URL로 자동 전환)
# Deploy your own worker: modal deploy modal_mediapipe_worker.py
MODAL_MEDIAPIPE_URL_1=https://YOUR_MODAL_ACCOUNT--movecl-mediapipe-fastapi-app.modal.run
MODAL_MEDIAPIPE_URL_2=
# Legacy single URL (optional)
MODAL_MEDIAPIPE_URL=

# Modal Token (for deploying workers)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Apple Push Notifications (APNs)
APNS_BUNDLE_ID=com.yourapp.bundle
APNS_TEAM_ID=XXXXXXXXXX
APNS_KEY_ID=XXXXXXXXXX
# Base64-encoded .p8 key, split into 3 parts due to env var length limits
APNS_KEY_P8_B64_1=
APNS_KEY_P8_B64_2=
APNS_KEY_P8_B64_3=

# Cloudflare R2 Object Storage
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=your-bucket-name
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Admin / Internal
ADMIN_TOKEN=
CREDITS_ADMIN_SECRET=
STATS_SECRET=
SESSION_SECRET=

# App
PUBLIC_DOMAIN=https://yourdomain.com
NODE_ENV=production
LOG_LEVEL=info

# Feature flags (optional)
ANNOUNCEMENT_ENABLED=false
MAINTENANCE_UNTIL=
